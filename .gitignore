# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Vendor / large binaries (ZED SDK installers, wheels, etc.)
vendor/
*.run
*.whl

# Onshape API credentials (never commit)
.env

# onshape-to-robot export meshes (258 MB of per-part STLs; robot.xml + config.json ARE
# tracked — the poses used by the sim are frozen in process_c3_mesh.py)
assets/CAD files/onshape_export/assets/
assets/CAD files/onshape_export_20260909/assets/

# acados generated C code (regenerated on solver construction; not a source artifact)
**/dobmpc/_acados_gen/
MUJOCO_LOG.TXT
*.tar.gz
*.zip

# Local build cache
build_cache/

# THE data root (2026-09-14: one dated tree, data/YYYYMMDD/<run>[_kind]/ —
# rov_gui/runstore.py): gantry/ZED/survey captures, every rov_gui run record
# (screen/feed recordings, nav, controller CSVs, policy plans, on-site object
# reconstructions), diffusion-policy training runs and data/checkpoints/.
# One run is MB..GB; a reconstruction is tens of MB; a training run is ~28 GB.
# The path of a record lands in the meta / the _pose.jsonl MESH row instead.
data/

# Experiment data captures (GB-scale videos/images/IMU CSVs; keep on local disk,
# not in git — GitHub rejects the >100 MB rgb.mp4 files outright)
c3_camera/datasets/
c3_camera/recordings/
bluerov2_mujoco_marinegym/recordings/

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Make sure requirements.txt is tracked even if a parent rule would match
!requirements.txt

# MuJoCo auto-generated error log + ad-hoc nohup run logs
MUJOCO_LOG.TXT
run.log

# (sessions/ — the old rov_gui output root — was folded into data/ on
# 2026-09-14 by tools/migrate_data_layout_20260914.py; the mapping is
# data/MIGRATION_20260914.json. Kept ignored so a stray recreation never lands
# in git.)
sessions/

# Regenerated figures (rov_gui/tools/plot_runs.py). Derived from data/,
# which is itself ignored: committing the pictures would outlive the data they
# came from and turn into unreproducible claims. Rerun `./c3 plots` instead.
figures/
